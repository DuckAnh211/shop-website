{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/products", "dest": "/api/index.js" },
    { "src": "/admin/login", "dest": "/api/index.js" },
    { "src": "/admin/add-product", "dest": "/api/index.js" },
    { "src": "/admin/products/([^/]+)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
